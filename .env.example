# 本项目统一使用 UTF-8（无 BOM）编码。
# 复制本文件为 .env 并填入真实密钥。
# .env 已被 .gitignore 忽略 —— 绝不提交真实密钥到 git。
# config.py 会在加载时自动读取 .env（python-dotenv），无需手动 export。
# 注意：已存在的同名系统环境变量优先于 .env。

# LLM（DeepSeek / OpenAI 兼容端点）
OPENAI_API_KEY=<填入你的 DeepSeek 或 OpenAI key>

# VLM（DashScope / qwen-vl 多模态）
DASHSCOPE_API_KEY=<填入你的 DashScope key>

# 票多星票务平台（被测系统 SUT）——管理端账号与商城用例客户密码。
# 管理端地址 /login，后端 API 地址 http://localhost:8088/api；管理员密码与
# 票多星后端 .env 的 BOOKING_ADMIN_PASSWORD 保持一致。
BOOKING_ADMIN_USERNAME=admin
BOOKING_ADMIN_PASSWORD=<填入票多星管理员密码>
# 商城用例客户 selfheal_customer 的密码（首次运行 e2e 时经 /api/user/register 注册）
BOOKING_CUSTOMER_PASSWORD=<填入自建测试客户密码>
